# Copy to .env and fill in real values. Never commit the real .env.
# The app fails to boot if any variable marked "required" is missing.

# ── JWT (required) ───────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# ── Database (required) ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smsemail

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the client's VITE_GOOGLE_REDIRECT_URI.
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ── Gmail refresh-token encryption (required, >= 32 chars) ───────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this makes existing stored refresh tokens undecryptable (forces re-consent).
REFRESH_TOKEN_KEY=

# ── Gmail Pub/Sub push ───────────────────────────────────────────────────────
GOOGLE_PUBSUB_TOPIC=projects/<project>/topics/<topic>
# Service account email that Pub/Sub uses to sign push OIDC tokens (webhook verify).
GOOGLE_PUBSUB_SA_EMAIL=

# ── SignalWire SMS ───────────────────────────────────────────────────────────
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_API_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PHONE_NUMBER=
# Public https base URL of this server, used to rebuild the signed webhook URL
# for HMAC verification (must match the URL configured in SignalWire).
PUBLIC_URL=https://emailontext.com
# Inbound SMS signature verification is enforced by default. Set to "false" only
# as a temporary kill switch if legitimate inbound SMS starts failing.
# SIGNALWIRE_VERIFY_SIGNATURE=false

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_TEST_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ── App ──────────────────────────────────────────────────────────────────────
# Displayed subscription price (dollars). Display-only.
PRICE=5.99
# Comma-separated admin email allowlist (must be real logged-in users).
ADMIN_EMAILS=
